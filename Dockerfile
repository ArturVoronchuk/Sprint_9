# Создать образ на основе базового слоя,
# который содержит файлы ОС и интерпретатор Python 3.13.
FROM python:3.13

# Переходим в образе в директорию /app:
WORKDIR /app

# Копирование зависимостей в текущую директорию /app.
COPY requirements.txt .

# Выполнить в текущей директории команду терминала для установки зависимостей.
RUN pip install -r requirements.txt

# Скопировать всё необходимое содержимое
# той директории локального компьютера, где сохранён Dockerfile,
# в текущую рабочую директорию образа — /app.
COPY . .

# При старте контейнера запустить тесты.
CMD ["python", "-m", "pytest", "--headless", "--alluredir=allure-results"]
